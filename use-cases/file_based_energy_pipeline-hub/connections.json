{
  "pipeline": {
    "name": "File Based Energy Pipeline (Docker Hub images)",
    "description": "Same pipeline as file_based_energy_pipeline, but services reference public Docker Hub images so they can be pulled and run without building locally.",
    "start_service": "input-provider",
    "service_mapping": {
      "input_provider": {
        "ip_address": "input-provider",
        "port": 8080,
        "image": "borgdrone7/ai-effect-file-based-input-provider:latest"
      },
      "data_generator": {
        "ip_address": "data-generator",
        "port": 8080,
        "image": "borgdrone7/ai-effect-file-based-data-generator:latest"
      },
      "data_analyzer": {
        "ip_address": "data-analyzer",
        "port": 8080,
        "image": "borgdrone7/ai-effect-file-based-data-analyzer:latest"
      },
      "report_generator": {
        "ip_address": "report-generator",
        "port": 8080,
        "image": "borgdrone7/ai-effect-file-based-report-generator:latest"
      }
    },
    "connections": [
      {
        "from_service": "input-provider",
        "from_method": "GetConfiguration",
        "to_service": "data-generator",
        "to_method": "GenerateData"
      },
      {
        "from_service": "data-generator",
        "from_method": "GenerateData",
        "to_service": "data-analyzer",
        "to_method": "AnalyzeData"
      },
      {
        "from_service": "data-analyzer",
        "from_method": "AnalyzeData",
        "to_service": "report-generator",
        "to_method": "GenerateReport"
      }
    ]
  }
}